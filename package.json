{
  "name": "dsh-gugugaga-pet",
  "version": "1.0.0",
  "private": true,
  "description": "咕咕嘎嘎：穿企鹅套装的小朋友，陪你在 DeepSeek Harness 工作。",
  "repository": {"type": "git", "url": "git+https://github.com/zealerFT/dsh-gugugaga.git"},
  "homepage": "https://github.com/zealerFT/dsh-gugugaga#readme",
  "bugs": {"url": "https://github.com/zealerFT/dsh-gugugaga/issues"},
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*"
  },
  "files": ["index.js", "lib", "assets", "locale", "cordis.patch.yml", "README.md", "CHANGELOG.md", "docs"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-connection"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "preview": "node scripts/preview.mjs",
    "pack:local": "npm run build && npm pack --pack-destination dist --ignore-scripts"
  },
  "devDependencies": {"esbuild": "0.27.0"},
  "engines": {"node": ">=22", "dsh": ">=0.2.2-rc.5"}
}
